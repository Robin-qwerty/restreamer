# Copy this file to .env (next to docker-compose.yml) and adjust it.
# Everything is optional; the defaults are shown.

# Image to run. scripts/build-local.sh builds restreamer:cuda-local (or :cuda-ffmpeg8-local,
# :default-local) on this machine. The default is the image from the GHCR workflow.
RESTREAMER_IMAGE=restreamer:cuda-local

# Published ports, as [ip:]port on the host. Prefix with 127.0.0.1: to keep a port off the
# network, e.g. when a reverse proxy (nginx, Apache, Caddy) on the same server serves the UI.
RESTREAMER_HTTP=8080
RESTREAMER_HTTPS=8181
RESTREAMER_RTMP=1935
RESTREAMER_RTMPS=1936
RESTREAMER_SRT=6000

# Where the configuration (config.json, channel database) and the data (player site,
# recordings) are stored on the host. Back up the config directory.
RESTREAMER_CONFIG_DIR=./config
RESTREAMER_DATA_DIR=./data

# Restreamer settings such as the domain (host name), HTTPS certificate, RTMP token and the
# admin login are set in the UI (Settings) and saved in the config directory.
